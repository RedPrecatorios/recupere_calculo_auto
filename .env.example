# =============================================================================
# Google Drive
# =============================================================================
# ID da pasta no Drive (visível na URL: drive.google.com/.../folders/ESTE_ID)
GOOGLE_DRIVE_FOLDER_ID=0AAjZDXCT6WDcUk9PVA

# Caminho para o JSON da Service Account do Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
GOOGLE_DRIVE_RECURSIVE=true
GOOGLE_DRIVE_ONLY_DATE_FOLDERS=false
GOOGLE_DRIVE_MAX_DEPTH=10
PDF_DOWNLOAD_PATH=pdfs
PDF_REMOVE_AFTER_PROCESSING=false
MODELS_DEMONSTRATIVOS_PATH=modelos/demonstrativos
EXTRACTED_DEMONSTRATIVOS_PATH=pdfs_extraidos/demonstrativos
MODELS_REQUISITORIOS_PATH=modelos/requisitórios
EXTRACTED_REQUISITORIOS_PATH=pdfs_extraidos/requisitorios

# =============================================================================
# LLM (OpenAI / Gemini) — escolha o provedor de parse de PDFs
# =============================================================================
# openai = ChatGPT | gemini = Google Gemini 3.5 Flash
LLM_PROVIDER=gemini #openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Preencha ao usar LLM_PROVIDER=gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Prompt enviado junto com cada PDF. O modelo deve retornar JSON.
OPENAI_EXTRACTION_PROMPT=

# Demonstrativos: prompt em arquivo (restituição IR — Etapas 1–3 estruturadas em JSON)
# Para sobrescrever inline, preencha OPENAI_DEMONSTRATIVO_PROMPT (deixe vazio para usar o arquivo)
OPENAI_DEMONSTRATIVO_PROMPT=
OPENAI_DEMONSTRATIVO_PROMPT_FILE=prompts/demonstrativo_restituicao_ir.txt
OPENAI_COMPROVANTE_PROMPT_FILE=prompts/comprovante_levantamento.txt

DEMONSTRATIVO_EXTRACTIONS_OUTPUT_PATH=data/extracoes/demonstrativos
DEMONSTRATIVO_CAMPOS_OUTPUT_PATH=data/extracoes/demonstrativos_campos
COMPROVANTES_CAIXA_OUTPUT_PATH=data/extracoes/comprovantes_caixa
COMPROVANTES_CAIXA_STATUS_OUTPUT_PATH=data/extracoes/comprovantes_caixa
CAIXA_DEPOSITO_JUDICIAL_BASE_URL=
COMPROVANTES_BB_OUTPUT_PATH=data/extracoes/comprovantes_bb
COMPROVANTES_BB_STATUS_OUTPUT_PATH=data/extracoes/comprovantes_bb
BB_RESGATE_BASE_URL=

# =============================================================================
# Monday.com
# =============================================================================
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=6808266985
MONDAY_GROUP_ID=teste

# Mapeamento opcional: coluna_monday=campo_json (separados por vírgula)
# Exemplo: texto0=cliente,texto1=valor,texto2=cpf
MONDAY_COLUMN_MAPPING=

# Anexa demonstrativo + comprovante na aba/coluna Arquivos (sem Atualizações)
MONDAY_ATTACH_PDFS=true
MONDAY_FILES_COLUMN_ID=file_mm5rjmz0

# =============================================================================
# Aplicação
# =============================================================================
LOG_LEVEL=INFO
DATABASE_PATH=data/processamentos.db
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120
OPENAI_REQUEST_DELAY_SECONDS=2

AUTO_RECUPERE_DB_HOST=147.182.183.12
AUTO_RECUPERE_DB_PORT=3306
AUTO_RECUPERE_DB_NAME=auto_recupere
AUTO_RECUPERE_DB_USER=auto_recupere_user
AUTO_RECUPERE_DB_PASSWORD=

MONDAY_ULTIMO_ENVIO_ID=17859

# python -m recupere_monday.main --rodar-fluxo-por-processo --data-drive 26-06-2026 --limite 3 --processar-calculos-ia
# =============================================================================
# Proxy rotativo Webshare (Caixa, BB, RRA, Selic)
# =============================================================================
HTTP_USE_PROXY=true
WEBSHARE_PROXIES_LIST=./webshare_proxies.txt
HTTP_PROXY_MAX_ATTEMPTS=3
HTTP_PROXY_URL=

# Terminal: simple = limpo em português | verbose = logs técnicos
LOG_STYLE=simple
# LOG_LEVEL=INFO
